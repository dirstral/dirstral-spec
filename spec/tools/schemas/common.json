{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spec.dirstral.com/tools/schemas/common.json",
  "title": "dir2mcp_common",
  "description": "Shared schema definitions used by multiple tool contract documents.",
  "definitions": {
    "Span": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "lines"
            },
            "start_line": {
              "type": "integer"
            },
            "end_line": {
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "start_line",
            "end_line"
          ]
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "page"
            },
            "page": {
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "page"
          ]
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "time"
            },
            "start_ms": {
              "type": "integer"
            },
            "end_ms": {
              "type": "integer"
            },
            "speaker": {
              "type": "string",
              "description": "Optional (SPEC \u00a78.6.8): stable per-transcript speaker id on a diarized transcript."
            },
            "speaker_label": {
              "type": "string",
              "description": "Optional human-readable speaker name (SPEC \u00a78.6.8)."
            },
            "entities": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional (SPEC 5.4, design 0004): entity ids the recognizer attributed to this span. Same values the entities filter matches. Absent on a span that is not a recognition annotation."
            },
            "attributes": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "propertyNames": { "not": { "pattern": "^dir2mcp:" } },
              "description": "Optional (SPEC 9.10, design 0006): the producer-defined key/value scopes the recognizer attached to this annotation, for example {\"inning\": \"8\"}. Same values the attributes filter matches. Absent on a span that is not a recognition annotation."
            },
            "event": {
              "type": "string",
              "description": "Optional (SPEC 5.4, design 0004): the producer's event token for this span, for example pitch or home_run. Same value the events filter matches. The vocabulary is producer-defined and not enumerated here."
            },
            "derivation": {
              "type": "string",
              "enum": [
                "observed",
                "generated"
              ],
              "description": "Optional (SPEC 5.4): whether this span records something observed or something a model generated. Absent means observed. A client MUST NOT present a generated span as a record of what happened."
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional (df-005): the recognizers that contributed to this annotation, for example [\"scorebug\"] or [\"playbyplay\",\"face\"]. Producer-defined tags, not a closed set and not a relevance signal. A client MAY use them to explain or weigh a hit, because recognizers differ in reliability."
            }
          },
          "required": [
            "kind",
            "start_ms",
            "end_ms"
          ]
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "region"
            },
            "start_page": {
              "type": "integer"
            },
            "end_page": {
              "type": "integer"
            },
            "bbox": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "page": {
                  "type": "integer"
                },
                "l": {
                  "type": "number"
                },
                "t": {
                  "type": "number"
                },
                "r": {
                  "type": "number"
                },
                "b": {
                  "type": "number"
                },
                "coord_origin": {
                  "enum": [
                    "TOPLEFT",
                    "BOTTOMLEFT"
                  ]
                }
              },
              "required": [
                "page",
                "l",
                "t",
                "r",
                "b",
                "coord_origin"
              ]
            },
            "section": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "start_page",
            "end_page",
            "bbox"
          ]
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "document"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "Hit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "type": "integer"
        },
        "rel_path": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "doc_type": {
          "type": "string"
        },
        "rep_type": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "snippet": {
          "type": "string"
        },
        "span": {
          "$ref": "#/definitions/Span"
        },
        "modality": {
          "type": "string",
          "description": "Media/multimodal chunks (td-002 multimodal media chunks): e.g. text/image/audio/video. Omitted for plain text."
        },
        "evidence": {
        "type": "string",
        "enum": ["strong", "sufficient", "insufficient", "unknown"],
        "description": "Absolute evidence verdict for this hit, measured against the server's documented per-scale thresholds (SPEC 9.4.3): sufficient / insufficient say the hit's absolute signal cleared / missed its scale's threshold; strong is an OPTIONAL refinement a server emits only if it documents a stronger threshold; unknown means the hit carries no absolute signal (e.g. a purely lexical hit). Never a raw score: raw scores are incomparable across retrieval modes (SPEC 9.1.1). Optional; a server MUST NOT emit it unless it advertises a schema that declares it."
      },
      "media_ref": {
          "type": "string",
          "description": "Media/multimodal chunks: reference to the source media used to embed this chunk. Omitted for plain text."
        }
      },
      "required": [
        "chunk_id",
        "rel_path",
        "score",
        "snippet",
        "span"
      ]
    },
    "Citation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "type": "integer"
        },
        "rel_path": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "span": {
          "$ref": "#/definitions/Span"
        }
      },
      "required": [
        "chunk_id",
        "rel_path",
        "span"
      ]
    }
  }
}
